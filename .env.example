# Copy to .env.local to make the app sync with the optional API (npm run dev:server).
# Leave it unset for the default: local only, fully offline.
VITE_API_URL=http://localhost:8787

# Optional, local tests and demos only: an astronaut token (npm run crew -- demo) used when nobody
# has signed in. Never set this for a public build: it ends up in the JavaScript bundle.
# VITE_API_TOKEN=chc_...
